	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.3982/{ECTA}17416},
	keywords = {Read, Star, {CREMR} demands, Gibrat's Law, heterogeneous firms, lognormal versus Pareto distributions, sales and markup distributions, Theory},
	file = {Full Text PDF:/Users/GARSON/Zotero/storage/VUR73PZA/Mrázová et al. - 2021 - Sales and Markup Dispersion Theory and Empirics.pdf:application/pdf;Snapshot:/Users/GARSON/Zotero/storage/2YKCLMMB/ECTA17416.html:text/html},
