}

@article{hallak_product_2006-1,
	title = {Product quality and the direction of trade},
	volume = {68},
	issn = {0022-1996},
	url = {https://www.sciencedirect.com/science/article/pii/S0022199605000516},
	doi = {10.1016/j.jinteco.2005.04.001},
	abstract = {A substantial amount of theoretical work predicts that quality plays an important role as a determinant of the global patterns of bilateral trade. This paper develops an empirical framework to estimate the empirical relevance of this prediction. In particular, it identifies the effect of quality operating on the demand side through the relationship between per capita income and aggregate demand for quality. The model yields predictions for bilateral flows at the sectoral level and is estimated using cross-sectional data for bilateral trade among 60 countries in 1995. The empirical results confirm the theoretical prediction: rich countries tend to import relatively more from countries that produce high-quality goods.},
	number = {1},
	urldate = {2025-02-26},
	journal = {Journal of International Economics},
	author = {Hallak, Juan Carlos},
	month = jan,
	year = {2006},
	keywords = {Gravity, Product quality, Bilateral trade, Linder, North–South trade, Quality},
	pages = {238--265},
	file = {PDF:C\:\\Users\\jonat\\Zotero\\storage\\J9R8DRKW\\Hallak - 2006 - Product quality and the direction of trade.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\jonat\\Zotero\\storage\\ZT5YPTVA\\S0022199605000516.html:text/html},
}

@misc{monardo_measuring_2021,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Measuring {Substitution} {Patterns} with a {Flexible} {Demand} {Model}},
	url = {https://papers.ssrn.com/abstract=3921601},
	doi = {10.2139/ssrn.3921601},
	abstract = {Many empirical studies require estimating how consumers substitute across differentiated products. Examples can be found in a wide range of fields of economics, including environmental economics, health care economics, industrial organization, and international trade. In this paper, I propose a computationally simple, easy-to-implement, flexible approach to estimate substitution patterns determined by how close products are in product characteristic space. To this end, I rely on an inverse market share model that (i) is consistent with utility maximization; (ii) does not use any specific assumptions about how substitution patterns depend on product characteristics; and (iii) is agnostic about individual consumer behavior. I find that my approach only requires solving a convex quadratic program with a small number of linear inequality constraints. I further find that it can outperform the state-of-the-art BLP approach pioneered by Berry, Levinsohn, and Pakes (1995), which accommodates flexible substitution patterns by using the random coefficient logit model. In particular, this occurs when (i) there is complementarity in demand; (ii) BLP is misspecified about its random coefficients; and (iii) consumers choose baskets of products. Lastly, I apply my approach to a well-known dataset for breakfast cereals and compare it to BLP. I find that it provides a better fit to the data than BLP. I further find that it yields similar median own-price elasticities, and higher median cross-price elasticities, markups, and merger price effects.},
	language = {en},
	urldate = {2025-02-27},
	publisher = {Social Science Research Network},
	author = {Monardo, Julien},
	month = nov,
	year = {2021},
	keywords = {Structural Econometric Model, Demand function, BLP, Differentiated products, Discrete choice models, Inverse demand, Random coefficient logit, Structural demand estimation},
	file = {Full Text PDF:C\:\\Users\\jonat\\Zotero\\storage\\W3JUET3J\\Monardo - 2021 - Measuring Substitution Patterns with a Flexible Demand Model.pdf:application/pdf},
}

@techreport{gandhi_measuring_2019,
