	pages = {877--921},
	file = {Snapshot:C\:\\Users\\jonat\\Zotero\\storage\\W3LVSX5N\\1903679.html:text/html;Version acceptée:C\:\\Users\\jonat\\Zotero\\storage\\HSWUJVTB\\Einav et al. - 2010 - Estimating Welfare in Insurance Markets Using Variation in Prices.pdf:application/pdf},
}

