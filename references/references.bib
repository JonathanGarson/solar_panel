	keywords = {Read, nonhomothetic preference, per capita income, price of imported food, quality of imported products},
	pages = {158--183},
	file = {PDF:C\:\\Users\\jonat\\Zotero\\storage\\QTGFZDM2\\Sun et al. - 2025 - Not the priciest, but the best quality A new interpretation of high import food price in China.pdf:application/pdf;Snapshot:C\:\\Users\\jonat\\Zotero\\storage\\VGVMUHRJ\\agr.html:text/html},
